# Copy to .env.local (apps/web) and fill in. Never commit real values.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Used ONLY by scripts/seed-master-data.mjs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Later phases (not used yet) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ANTHROPIC_API_KEY=

# --- Gmail inbox ---
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: OAuth client (Web application).
# Redirect URI to register: http://localhost:3000/api/gmail/callback
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts the Gmail refresh token before it is stored. Losing it means reconnecting Gmail.
TOKEN_ENCRYPTION_KEY=

# --- Xero (Developer Portal -> My Apps -> New app, type "Web app") ---
# Redirect URI to register EXACTLY: http://localhost:3000/api/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback
# Writes to a non-demo (production) Xero organisation are OFF unless this is exactly "true".
# Leave it unset until the Demo Company flow has been checked and you explicitly decide to go live.
# XERO_ALLOW_PRODUCTION_WRITES=true
